# ===== GoShare 忽略清单 =====

# Java / Maven 构建产物
**/target/
*.class

# 前端依赖与构建产物
node_modules/
dist/
.vite/
*.tsbuildinfo

# 临时目录（_work 放一次性产物，不入库）
_work/

# 日志
*.log
logs/

# IDE 配置
.idea/
*.iml
.vscode/
*.swp

# 系统文件
Thumbs.db
.DS_Store

# 本地环境配置（含密码等敏感信息）
.env
*.local.yml

# E2E 测试产物（含带时间戳的输出目录，例如 test-results-101011）
web/test-results*/
web/playwright-report/

# 压测原始响应（只保留汇总报告）
reports/load-segment-*/

# 本地助手工作目录（记忆、QA 临时产物，不入库）
**/.workbuddy/
